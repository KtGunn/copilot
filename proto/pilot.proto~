syntax = "proto3";
package sandbox;

import  "google/protobuf/empty.proto";
option go_package = "coptest/proto";


enum MyStatus {
     IMOK     = 0;
     NOTOK    = 1;
}

message Status {
        MyStatus State = 1;
}


service Async {
         rpc Update(stream Status) returns (google.protobuf.Empty);
}
